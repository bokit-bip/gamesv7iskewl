# ==============================================================================
#  GAMES V7 — ENVIRONMENT CONFIGURATION
#  Copy this file to .env and fill in your values. Never commit .env!
# ==============================================================================

# Port for the standalone Games V7 backend (default: 8080)
PORT=8080

# Official Owner account username (matches the official Bokit account)
GAMESV7_OWNER_USERNAME=bokit

# Local password for the Games V7 Owner account (hashed with scrypt on bootstrap).
# You can ALSO sign in as Owner via the BokitCord Owner Verification Bridge below.
GAMESV7_OWNER_PASSWORD=

# Independent AI Provider Configuration (OpenAI-compatible Chat Completions API)
# Example: NVIDIA NIM, OpenAI, OpenRouter, Ollama, or your own backend
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=
# Backward-compatible alias for AI_API_KEY:
NVIDIA_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: Custom external Music API URL (leave empty to use Games V7 built-in music backend)
MUSIC_API_URL=

# Optional: BokitCord API Origin for verifying the official Bokit Owner account
# Games V7 runs 100% independently if BokitCord is offline or unset.
BOKITCORD_API_URL=http://127.0.0.1:3000

# Optional: Comma-separated Games V7 VIP / Ad-Free codes (for independent redemption)
# Example: GAMESV7-VIP-2026,SKELETAL-FLOWERS-VIP
GAMESV7_VIP_CODES=
